configuration {
    modes: "drun";
    show-icons: true;
    display-drun: ""; /* a magnifier glyph from a Nerd Font */
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

@theme "/dev/null"

* {
    bg: #0a0a0a;           /* deep black background */
    bg-element: #161616;   /* dark grey search surface */
    fg: #ffffff;           /* white body text */
    fg-alt: #666666;       /* grey placeholder text */
    accent: #ffffff;       /* white accent */
    accent-text: #000000;  /* black text on the accent */

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    width: 500px;
    background-color: @bg;
    border: 1px solid;
    border-color: #222222;
    border-radius: 16px;
    padding: 20px;
}

mainbox {
    spacing: 15px;
}

inputbar {
    background-color: @bg-element;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 12px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg-alt;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @fg-alt;
    text-color: @fg;
    vertical-align: 0.5;
}

listview {
    lines: 10;
    fixed-height: false;  /* the window shrinks to the number of rows instead of always holding 10 */
    spacing: 6px;
    scrollbar: false;
    border: 0;
}

element {
    padding: 10px 14px;
    border-radius: 10px;
    spacing: 12px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @accent-text;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

/* ── The launcher hint line (rofi-launcher) ───────────────────────── */
/* Because of @theme "/dev/null" these widgets would otherwise be unstyled. */

message {
    background-color: @bg-element;
    border-radius: 12px;
    padding: 8px 12px;
}

textbox {
    background-color: transparent;
    text-color: @fg-alt;
    vertical-align: 0.5;
}

/* Error messages (rofi -e, and rofi's own theme parse errors) */
error-message {
    background-color: @bg;
    border: 1px solid;
    border-color: #222222;
    border-radius: 16px;
    padding: 20px;
}
